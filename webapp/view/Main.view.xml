<mvc:View controllerName="tasktwo.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Table id="booksTable" items="{/books}" mode="MultiSelect">
            <headerToolbar>
                <Toolbar id="tableToolbar">
                    <Button id="addBtn" text="Add Record" press=".onAddRecord"/>
                    <Button id="deleteBtn" text="Delete Record" press=".onDeleteRecord"/>
                    <ToolbarSeparator id="toolbarSep"/>
                    <Input id="nameFilter" width="12rem" placeholder="Title contains..."/>
                    <Select id="genreFilter" items="{/genres}">
                        <core:Item id="genreItem" key="{key}" text="{text}"/>
                    </Select>
                    <Button id="filterBtn" text="Filter" type="Emphasized" press=".onFilter"/>
                </Toolbar>
            </headerToolbar>
            <columns>
                <Column id="colId"><Text id="hdrId" text="ID"/></Column>
                <Column id="colName"><Text id="hdrName" text="Name"/></Column>
                <Column id="colAuthor"><Text id="hdrAuthor" text="Author"/></Column>
                <Column id="colGenre"><Text id="hdrGenre" text="Genre"/></Column>
                <Column id="colDate"><Text id="hdrDate" text="Release Date"/></Column>
                <Column id="colQty"><Text id="hdrQty" text="Available Qty"/></Column>
                <Column id="colActions"><Text id="hdrActions" text="Actions"/></Column>
            </columns>
            <items>
                <ColumnListItem id="bookItem">
                    <Text id="txtId" text="{ID}"/>
                    <VBox id="nameBox">
                        <Text id="txtName" text="{Name}" visible="{= !${editMode}}"/>
                        <Input id="inpName" value="{Name}" visible="{editMode}"/>
                    </VBox>
                    <Text id="txtAuthor" text="{Author}"/>
                    <Text id="txtGenre" text="{Genre}"/>
                    <Text id="txtDate" text="{path:'ReleaseDate', type:'sap.ui.model.type.Date', formatOptions:{style:'medium'}}"/>
                    <Text id="txtQty" text="{AvailableQuantity}"/>
                    <HBox id="actionsBox">
                        <Button id="editBtn" text="Edit Title" visible="{= !${editMode}}" press=".onEditTitle"/>
                        <Button id="saveBtn" text="Save" type="Emphasized" visible="{editMode}" press=".onSaveTitle"/>
                    </HBox>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>