<mvc:View controllerName="tasktwo.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Table id="booksTable" items="{/books}" mode="MultiSelect">
            <headerToolbar>
                <Toolbar id="tableToolbar">
                    <Button id="addBtn" text="{i18n>addRecord}" press=".onAddRecord"/>
                    <Button id="deleteBtn" text="{i18n>deleteRecord}" press=".onDeleteRecord"/>
                    <ToolbarSeparator id="toolbarSep"/>
                    <Input id="nameFilter" width="12rem" placeholder="{i18n>filterPlaceholder}"/>
                    <Select id="genreFilter" items="{/genres}">
                        <core:Item id="genreItem" key="{key}" text="{text}"/>
                    </Select>
                    <Button id="filterBtn" text="{i18n>filter}" type="Emphasized" press=".onFilter"/>
                </Toolbar>
            </headerToolbar>
            <columns>
                <Column id="colId"><Text id="hdrId" text="{i18n>labelId}"/></Column>
                <Column id="colName"><Text id="hdrName" text="{i18n>labelName}"/></Column>
                <Column id="colAuthor"><Text id="hdrAuthor" text="{i18n>labelAuthor}"/></Column>
                <Column id="colGenre"><Text id="hdrGenre" text="{i18n>labelGenre}"/></Column>
                <Column id="colDate"><Text id="hdrDate" text="{i18n>labelDate}"/></Column>
                <Column id="colQty"><Text id="hdrQty" text="{i18n>labelQty}"/></Column>
                <Column id="colActions"><Text id="hdrActions" text="{i18n>actions}"/></Column>
            </columns>
            <items>
                <ColumnListItem id="bookItem">
                    <Text id="txtId" text="{ID}"/>
                    <VBox id="nameBox">
                        <Text id="txtName" text="{Name}" visible="{= !${editMode}}"/>
                        <Input id="inpName" value="{Name}" visible="{editMode}"/>
                    </VBox>
                    <Text id="txtAuthor" text="{Author}"/>
                    <Text id="txtGenre" text="{Genre}"/>
                    <Text id="txtDate" text="{path: 'ReleaseDate', formatter: '.formatter.publishedYear'}"/>
                    <Text id="txtQty" text="{AvailableQuantity}"/>
                    <HBox id="actionsBox">
                        <Button id="editBtn" text="{i18n>editTitle}" visible="{= !${editMode}}" press=".onEditTitle"/>
                        <Button id="saveBtn" text="{i18n>save}" type="Emphasized" visible="{editMode}" press=".onSaveTitle"/>
                    </HBox>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>